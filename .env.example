DATABASE_URL=postgresql://backline:backline@localhost:5432/backline
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional. Backline's `make embed` rebuilds rag.contract_chunks from
# {DATA_DIR}/contracts/txt/<pdf stem>.txt and aborts if any contract is missing
# that sidecar. Point this at Backline's data directory (the folder that
# contains contracts/) and Patchbay will write the sidecar after a successful
# insert. Existing sidecars are left untouched.
# BACKLINE_DATA_DIR=../backline/data
