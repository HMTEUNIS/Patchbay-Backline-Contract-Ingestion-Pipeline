DATABASE_URL=postgresql://backline:backline@localhost:5432/backline
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Required for a real insert. Point this at Backline's data directory (the
# folder that contains contracts/txt/). Patchbay writes
# contracts/txt/<pdf stem>.txt there after each insert and will not overwrite
# a different file. make embed reads that path for every contract and stops
# if one sidecar is missing. --dry-run does not need this.
# BACKLINE_DATA_DIR=../backline/data
